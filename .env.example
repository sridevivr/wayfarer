# Copy this file to .env and fill in real values. Never commit .env.
# Sources per tech spec §3:
#   FITBIT_*          -> dev.fitbit.com > Register an App
#   GOOGLE_MAPS_*     -> console.cloud.google.com > Credentials
#   ANTHROPIC_API_KEY -> console.anthropic.com > API Keys
#
# EXPO_PUBLIC_* vars are bundled into the client at build time. The
# Fitbit client id is safe to bundle because we use PKCE (public client
# OAuth flow). The client secret is NOT used and does not need to be
# present, but kept here for completeness if you ever switch flows.
#
# The Google Maps key is also EXPO_PUBLIC_* so PlaceAutocomplete can read
# it on-device. Restrict it by iOS bundle id in the GCP console — that's
# what keeps it safe to bundle.

EXPO_PUBLIC_FITBIT_CLIENT_ID=
FITBIT_CLIENT_SECRET=
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
ANTHROPIC_API_KEY=
